{
  "name": "indian-business-tycoon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time multiplayer Indian property-trading board game (React + Vite, Node + Oracle Cloud)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm --prefix server run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run && npm --prefix server test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "server": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@tanstack/react-query": "^5.80.0",
    "framer-motion": "^12.16.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "^4.1.1",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
