# Game server settings. On the VM this lives at /etc/ibt/server.env (chmod 600). Never commit real values.
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://blessingstonsk.github.io,http://localhost:5173
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# Google OAuth Web client ID (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Oracle Autonomous Database (TLS connect string from "Database connection", mTLS not required)
ORACLE_USER=IBT_APP
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
# Development only (ignored when NODE_ENV=production)
DEV_LOGIN=false
