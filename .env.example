# Public Firebase web config (not secret; security comes from Auth, Rules, App Check and backend checks).
# Copy to .env.local and fill per environment. Never put service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
# reCAPTCHA Enterprise site key for App Check (optional locally, required in production)
VITE_APPCHECK_SITE_KEY=
# "true" to connect to the local Firebase Emulator Suite
VITE_USE_EMULATORS=true
# "/" for a custom domain, or "/<repo-name>/" for a GitHub project page
VITE_APP_BASE_PATH=/
