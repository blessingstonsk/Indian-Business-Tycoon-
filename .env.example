# Frontend build settings (public values – never put secrets here).
# Game server base URL (no trailing slash). Dev default: http://localhost:8787
VITE_API_URL=
# Google OAuth Web client ID (APIs & Services → Credentials). Public.
VITE_GOOGLE_CLIENT_ID=
# Development only: show the "Test sign-in" box (server must run with DEV_LOGIN=true)
VITE_DEV_LOGIN=true
# "/" for a custom domain, or "/<repo-name>/" for a GitHub project page
VITE_APP_BASE_PATH=/
