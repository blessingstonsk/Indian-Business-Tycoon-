{
  "name": "ibt-functions",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,database",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  }
}
