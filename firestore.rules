rules_version = '2';

// Default deny. Clients only READ; every write goes through Cloud Functions (Admin SDK).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isRoomMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function isGameMember(gameId) {
      return signedIn() &&
        isRoomMember(get(/databases/$(database)/documents/games/$(gameId)).data.roomId);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    match /roomInvites/{inviteId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid);
      allow write: if false;
    }

    match /rooms/{roomId} {
      allow read: if isRoomMember(roomId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isRoomMember(roomId);
        allow write: if false;
      }
      match /reactions/{reactionId} {
        allow read: if isRoomMember(roomId);
        allow write: if false;
      }
    }

    match /games/{gameId} {
      allow read: if signedIn() && isRoomMember(resource.data.roomId);
      allow write: if false;

      match /events/{eventId} {
        allow read: if isGameMember(gameId);
        allow write: if false;
      }
      // games/{gameId}/private/* (deck order) has no rule → denied.
    }

    match /gameArchives/{archiveId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow write: if false;
    }

    // friendCodes, inviteCodes, commandReceipts, archiveJobs, rateLimits: server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
